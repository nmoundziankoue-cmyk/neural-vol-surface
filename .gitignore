# --- Python / backend ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# secrets / local overrides (committed: .env.example)
.env
.env.local
.env.*.local

# generated at runtime
backend/logs/
backend/models/*
# ...except the evaluation report, committed as a deploy seed so the
# hosted /api/evaluation returns the honest panel on a fresh container.
# Refresh it with `python scripts/evaluate.py` and redeploy.
!backend/models/evaluation_SPY.json

# --- Node / frontend ---
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
frontend/*.tsbuildinfo
frontend/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / editor ---
.DS_Store
*.pem
.vscode/
.idea/
