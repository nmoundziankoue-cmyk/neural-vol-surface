VOL_SURFACE_TICKER=SPY
VOL_SURFACE_RATE_TICKER=^IRX
DATABASE_URL=postgresql+psycopg2://vol_user:vol_pass@localhost:5432/vol_surface
MIN_OPEN_INTEREST=1
MAX_RELATIVE_SPREAD=0.5
MIN_DTE=2

# CORS: origin allowed to call the API. In prod, set this to the deployed
# frontend's URL (e.g. https://your-app.vercel.app).
FRONTEND_ORIGIN=http://localhost:3000
